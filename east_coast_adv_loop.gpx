  </wpt>
  <wpt lat="45.734760" lon="-73.966347">
    <name>Motel au P'tit Sapin (Mirabel)</name>
    <desc>Ground-level roadside motel on Route 117 in Mirabel. Room-front exterior motorcycle parking right outside your door.</desc>
    <sym>Lodging</sym>
  </wpt>
  <wpt lat="49.215000" lon="-68.155000">
    <name>Travelodge by Wyndham Baie-Comeau</name>
    <desc>Clean, highly-rated rider-friendly motor inn directly on Route 138. Easy ground-floor motorcycle parking.</desc>
    <sym>Lodging</sym>
  </wpt>
  <wpt lat="52.910000" lon="-66.860000">
    <name>Hotel Wabush</name>
    <desc>Safe, warm, rider-friendly hotel in Labrador West. On-site restaurant, high-speed WiFi, bear-safe protection.</desc>
    <sym>Lodging</sym>
  </wpt>
  <wpt lat="53.305000" lon="-60.325000">
    <name>Royal Inn &amp; Suites (Goose Bay)</name>
    <desc>Quiet, comfortable suites with kitchenettes in Happy Valley-Goose Bay. Secure parking, hot showers.</desc>
