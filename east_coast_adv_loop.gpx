  </wpt>
  <wpt lat="51.420000" lon="-57.060000">
    <name>Northern Light Inn (L'Anse-au-Clair)</name>
    <desc>Rider-favorite coastal hotel 5 km from Blanc-Sablon ferry terminal. Warm rooms, seafood dining, early ferry staging.</desc>
    <sym>Lodging</sym>
  </wpt>
  <wpt lat="51.583300" lon="-55.533300">
    <name>Snorri Cabins / Valhalla Lodge (Hay Cove)</name>
    <desc>Authentic turf-roofed and wooden rustic Viking cabins 2 km from L'Anse aux Meadows. Full kitchen, private deck, ocean vistas.</desc>
    <sym>Lodging</sym>
  </wpt>
  <wpt lat="51.583300" lon="-55.533300">
    <name>Snorri Cabins / Valhalla Lodge (Hay Cove) - Night 2</name>
    <desc>Night 2 in the Viking cabins. Relax around the woodstove after exploring Norstead and St. Anthony.</desc>
    <sym>Lodging</sym>
  </wpt>
  <wpt lat="49.560000" lon="-57.880000">
    <name>Gros Morne / Norris Point KOA Holiday</name>
    <desc>Full-service KOA at Route 430 junction in Gros Morne. Commercial laundromat to reset riding gear, heated pool, hot showers, bike wash.</desc>
    <sym>Lodging</sym>
  </wpt>
  <wpt lat="49.683300" lon="-57.850000">
    <name>Green Point Campground (Gros Morne NP)</name>
    <desc>World-class coastal drive-in campground in Gros Morne perched on seaside bluffs overlooking the Gulf of St. Lawrence. Ocean sunset, campfire surf.</desc>
    <sym>Lodging</sym>
  </wpt>
  <wpt lat="47.575000" lon="-59.136000">
    <name>Marine Atlantic Overnight Ferry (Private 2-Berth Stateroom Cabin)</name>
    <desc>Private 2-berth en-suite stateroom aboard MV Highlanders / MV Blue Puttees. Boarding 21:45, sailing 23:45 across Cabot Strait to North Sydney arriving 07:00 AM.</desc>
    <sym>Lodging</sym>
  </wpt>
  <wpt lat="46.680000" lon="-60.400000">
