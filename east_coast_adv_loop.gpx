  <wpt lat="48.145000" lon="-69.715000">
    <name>Tadoussac Fjord Ferry (Route 138)</name>
    <desc>Free 10-minute year-round ferry crossing across the mouth of the Saguenay Fjord. Motorcyclists directed to front of queue.</desc>
    <sym>Ferry</sym>
  </wpt>
  <wpt lat="51.425000" lon="-57.135000">
    <name>Blanc-Sablon to St. Barbe Ferry (MV Qajaq W)</name>
    <desc>90-minute marine ferry across the Strait of Belle Isle into Newfoundland. Chocks and heavy-duty straps provided for motorcycles.</desc>
    <sym>Ferry</sym>
  </wpt>
  <wpt lat="47.573900" lon="-59.136700">
    <name>Marine Atlantic Port aux Basques Overnight Ferry</name>
    <desc>Marine Atlantic 7-hour overnight marine ferry across the Cabot Strait to North Sydney aboard MV Highlanders. Departs 23:45, arrives 07:00 AM.</desc>
    <sym>Ferry</sym>
  </wpt>
  <wpt lat="45.645000" lon="-61.415000">
    <name>Canso Causeway (Cape Breton Island Gateway)</name>
    <desc>Massive rock-fill causeway carrying Highway 104 across the Strait of Canso connecting mainland Nova Scotia to Cape Breton Island.</desc>
    <sym>Ferry</sym>
  </wpt>
  <wpt lat="46.155000" lon="-63.812000">
    <name>Confederation Bridge (Inbound Toll-Free Crossing)</name>
    <desc>12.9 km curved marine highway bridge spanning Northumberland Strait from New Brunswick onto PEI. 100% modified asphalt, zero grates, 100% toll-free inbound!</desc>
    <sym>Ferry</sym>
  </wpt>
  <wpt lat="46.259600" lon="-63.679800">
    <name>Confederation Bridge (Outbound Toll Plaza)</name>
    <desc>Toll plaza in Borden-Carleton upon departing PEI back to New Brunswick. Motorcycle toll is ~$20.25 CAD per motorcycle.</desc>
    <sym>Ferry</sym>
  </wpt>
  <wpt lat="45.305000" lon="-74.025000">
    <name>Pont Serge-Marcil (A-30 Express Toll Bridge)</name>
    <desc>High-speed 2.5 km toll bridge over the St. Lawrence Seaway bypassing Montreal metro traffic on Autoroute 30.</desc>
    <sym>Ferry</sym>
  </wpt>
  <wpt lat="45.593286" lon="-76.660131">
    <name>Portage-du-Fort Ottawa River Crossing</name>
    <desc>Historic Chenaux Generating Station dam bridge crossing the Ottawa River from Ontario into Quebec.</desc>
    <sym>Scenic Area</sym>
  </wpt>
  <wpt lat="45.625800" lon="-74.434600">
    <name>Route 148 Scenic River Corridor (Gatineau to Fassett)</name>
    <desc>Winding, scenic motorcycle corridor along the north shore of the Ottawa River through St-Philippe and Lachute into Mirabel.</desc>
    <sym>Scenic Area</sym>
  </wpt>
  <wpt lat="46.805000" lon="-71.210000">
    <name>Boulevard Champlain &amp; Cap Diamant River Parkway</name>
    <desc>Stunning river-level motorcycle boulevard curving beneath the towering cliffs of Quebec City and Château Frontenac.</desc>
    <sym>Scenic Area</sym>
  </wpt>
  <wpt lat="46.900000" lon="-70.900000">
    <name>Autoroute 50 &amp; Route 138 North Shore Scenic Corridor</name>
    <desc>Historic Chemin du Roy and Côte-de-Beaupré bypassing Montreal and Hwy 40 entirely.</desc>
    <sym>Scenic Area</sym>
  </wpt>
  <wpt lat="49.475000" lon="-57.964000">
    <name>The Tablelands (Earth's Mantle)</name>
    <desc>Rare barren orange landscape of exposed oceanic crust and Earth's mantle pushed up by continental drift.</desc>
    <sym>Scenic Area</sym>
  </wpt>
  <wpt lat="46.600000" lon="-60.416700">
    <name>Cape Smokey Look-off &amp; Gondola</name>
    <desc>Thrilling coastal hairpin climb to high mountain look-off overlooking Ingonish and the Atlantic Ocean.</desc>
    <sym>Scenic Area</sym>
  </wpt>
  <wpt lat="47.026400" lon="-60.557800">
    <name>Meat Cove Clifftop Adventure Spur &amp; Chowder Hut</name>
    <desc>The wild northernmost tip of Nova Scotia. 29 km spur ending with an 8 km clifftop ocean track and clifftop chowder hut.</desc>
    <sym>Scenic Area</sym>
  </wpt>
  <wpt lat="46.730000" lon="-60.880000">
    <name>French Mountain Switchbacks</name>
    <desc>The signature postcard hairpins of the Cabot Trail carved into sheer mountain coastal bluffs.</desc>
    <sym>Scenic Area</sym>
  </wpt>
  <wpt lat="46.635000" lon="-61.005000">
    <name>Aucoin Bakery (Chéticamp)</name>
    <desc>Famous Acadian bakery operating since 1955. Traditional meat pies, pastries, and breads.</desc>
    <sym>Scenic Area</sym>
  </wpt>
  <wpt lat="45.820000" lon="-64.570000">
    <name>Hopewell Rocks (Tidal Floor Walk)</name>
    <desc>Walk on the ocean floor around towering flowerpot sea stack formations carved by 46-foot Fundy tides.</desc>
    <sym>Scenic Area</sym>
  </wpt>
  <wpt lat="45.410000" lon="-65.450000">
    <name>Fundy Trail Parkway</name>
    <desc>Spectacular 30 km coastal motorcycling parkway ridden continuous from East Gate to West Gate past Walton Glen Gorge, Long Beach, Big Salmon River, and Fuller Falls to Saint John.</desc>
    <sym>Scenic Area</sym>
  </wpt>
  <wpt lat="45.259700" lon="-66.088600">
    <name>Reversing Falls Rapids (Saint John)</name>
    <desc>Spectacular tidal phenomenon where 28-foot Bay of Fundy tides force the mighty Saint John River to reverse its flow through a narrow rocky gorge.</desc>
    <sym>Scenic Area</sym>
  </wpt>
