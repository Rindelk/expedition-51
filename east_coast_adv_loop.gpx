<gpx version="1.1" creator="Expedition 51 Master Planner" xmlns="http://www.topografix.com/GPX/1/1">
  <metadata><name>2027 East Coast &amp; Labrador Moto Expedition (Expedition 51)</name></metadata>
  <wpt lat="46.656232" lon="-80.882479"><name>Hanmer Home Base (Start)</name><desc>[Day 1] (hotel-primary) Expedition departure point (4671 Dupuis Drive, Hanmer, ON). Full 87 &amp; 91 fuel tanks.</desc><type>hotel-primary</type></wpt>
  <wpt lat="45.73476" lon="-73.966347"><name>Motel au P'tit Sapin (Mirabel)</name><desc>[Day 1] (hotel-primary) Ground-level roadside motel on Route 117 in Mirabel. Room-front exterior motorcycle parking right outside your door.</desc><type>hotel-primary</type></wpt>
  <wpt lat="45.728" lon="-73.978"><name>Motel Le Mirabeau (Mirabel)</name><desc>[Day 1] (hotel-secondary) Clean, comfortable roadside motel fallback on Route 117 in Mirabel.</desc><type>hotel-secondary</type></wpt>
  <wpt lat="45.7508" lon="-74.0044"><name>Super 8 by Wyndham Saint-Jérôme / Mirabel</name><desc>[Day 1] (hotel-secondary) Convenient fallback motor hotel off Hwy 117 / A-15 gateway.</desc><type>hotel-secondary</type></wpt>
  <wpt lat="45.715" lon="-73.995"><name>Camping Mirabel</name><desc>[Day 1] (park) Lush wooded private campground with pool and hot showers in Mirabel.</desc><type>park</type></wpt>
  <wpt lat="45.568" lon="-74.376"><name>Carillon Canal National Historic Lock</name><desc>[Day 1] (attraction) Historic 19th-century military canal on the Ottawa River built after the War of 1812 with a massive 20-metre single hydraulic guillotine lock.</desc><type>attraction</type></wpt>
  <wpt lat="46.363" lon="-79.932"><name>Sturgeon Falls Shell</name><desc>[Day 1] (fuel) Hwy 17 full service Shell with V-Power 91 Premium.</desc><type>fuel</type></wpt>
  <wpt lat="46.2" lon="-77.49"><name>Deep River Canadian Tire Gas+</name><desc>[Day 1] (fuel) Trans-Canada Hwy 17 backup station with 91 Premium.</desc><type>fuel</type></wpt>
  <wpt lat="45.8267" lon="-77.1111"><name>Pembroke Esso / Circle K</name><desc>[Day 1] (fuel) Major Hwy 17 fuel stop before crossing Chenaux Dam into Quebec.</desc><type>fuel</type></wpt>
  <wpt lat="45.6033" lon="-76.488"><name>Shawville Petro-Canada</name><desc>[Day 1] (fuel) Route 148 fuel in the heart of Pontiac county.</desc><type>fuel</type></wpt>
  <wpt lat="45.596" lon="-75.241"><name>Thurso Ultramar</name><desc>[Day 1] (fuel) Route 148 Ottawa River backup station with 91 Premium.</desc><type>fuel</type></wpt>
  <wpt lat="45.6517" lon="-74.9417"><name>Montebello Shell</name><desc>[Day 1] (fuel) Scenic Route 148 Ottawa River corridor fuel.</desc><type>fuel</type></wpt>
  <wpt lat="45.733" lon="-73.968"><name>Mirabel Ultramar (Route 117)</name><desc>[Day 1] (fuel) Convenient fuel top-off right next to Motel au P'tit Sapin.</desc><type>fuel</type></wpt>
  <wpt lat="45.895" lon="-77.275"><name>Petawawa Shell (Hwy 17)</name><desc>[Day 1] (fuel) Strategic backup station on Hwy 17 eastbound 20 km before Pembroke.</desc><type>fuel</type></wpt>
  <wpt lat="45.593286" lon="-76.660131"><name>Portage-du-Fort Ottawa River Crossing</name><desc>[Day 1] (sight) Historic Chenaux Generating Station dam bridge crossing the Ottawa River from Ontario into Quebec.</desc><type>sight</type></wpt>
  <wpt lat="45.6258" lon="-74.4346"><name>Route 148 Scenic River Corridor (Gatineau to Fassett)</name><desc>[Day 1] (sight) Winding, scenic motorcycle corridor along the north shore of the Ottawa River through St-Philippe and Lachute into Mirabel.</desc><type>sight</type></wpt>
  <wpt lat="45.8268" lon="-77.1125"><name>The Nook Creperie (Pembroke)</name><desc>[Day 1] (food) Charming downtown Pembroke creperie serving sweet &amp; savory buckwheat crepes, paninis, and espresso — ideal Day 1 lunch stop along Hwy 17.</desc><type>food</type></wpt>
  <wpt lat="46.3125" lon="-79.4428"><name>Twiggs Coffee Roasters (North Bay — Hwy 17)</name><desc>[Day 1] (coffee) 473 Fraser St / McKeown Ave, North Bay, ON. Famous Northern Ontario micro-roaster — fresh espresso, baked scones, and rider breakfast stop on Day 1 &amp; Day 18.</desc><type>coffee</type></wpt>
  <wpt lat="46.3658" lon="-79.9272"><name>Tim Hortons (Sturgeon Falls — Hwy 17)</name><desc>[Day 1] (coffee) Front St / Trans-Canada Hwy 17, Sturgeon Falls, ON. First morning coffee stop east of Hanmer.</desc><type>coffee</type></wpt>
  <wpt lat="46.3142" lon="-78.7058"><name>Tim Hortons (Mattawa — Hwy 17)</name><desc>[Day 1] (coffee) Main St / Hwy 17, Mattawa, ON. Convenient coffee &amp; restroom stop at the confluence of the Mattawa and Ottawa rivers.</desc><type>coffee</type></wpt>
  <wpt lat="45.8152" lon="-77.1145"><name>Tim Hortons (Pembroke — Hwy 17)</name><desc>[Day 1] (coffee) Pembroke St W, Pembroke, ON. Quick coffee &amp; snack stop along the Ottawa Valley corridor.</desc><type>coffee</type></wpt>
  <wpt lat="45.8214" lon="-77.0812"><name>Starbucks (Pembroke — Pembroke Mall)</name><desc>[Day 1] (coffee) 1100 Pembroke St E, Pembroke, ON. Espresso &amp; cold brew stop right along the Ottawa River corridor.</desc><type>coffee</type></wpt>
  <wpt lat="45.6912" lon="-74.0885"><name>Tim Hortons (Mirabel — Route 117)</name><desc>[Day 1] (coffee) 13425 Bd Curé-Labelle, Mirabel, QC. Right beside Day 1 lodging for Day 2 07:00 AM rollout coffee.</desc><type>coffee</type></wpt>
  <wpt lat="49.215" lon="-68.155"><name>Travelodge by Wyndham Baie-Comeau</name><desc>[Day 2] (hotel-primary) Clean, highly-rated rider-friendly motor inn directly on Route 138. Easy ground-floor motorcycle parking.</desc><type>hotel-primary</type></wpt>
  <wpt lat="49.218" lon="-68.1482"><name>Hôtel Le Manoir Baie-Comeau</name><desc>[Day 2] (hotel-secondary) Historic stone manor overlooking the St. Lawrence River.</desc><type>hotel-secondary</type></wpt>
  <wpt lat="48.16" lon="-69.72"><name>Parc national du Fjord-du-Saguenay (Tadoussac)</name><desc>[Day 2] (park) Spectacular fjord park with marine mammal lookouts and coastal camping.</desc><type>park</type></wpt>
  <wpt lat="48.1542" lon="-69.6975"><name>Phare du Moulin-à-Baude (Tadoussac)</name><desc>[Day 2] (lighthouse) Historic red-and-white coastal beacon perched above the St. Lawrence estuary and Saguenay Fjord confluence; world-class beluga whale lookout.</desc><type>lighthouse</type></wpt>
  <wpt lat="48.337" lon="-69.467"><name>Phare de Cap-de-Bon-Désir</name><desc>[Day 2] (lighthouse) Historic navigational station on granite ledges dropping 300 meters into the St. Lawrence Laurentian Channel; prime shore whale watching.</desc><type>lighthouse</type></wpt>
  <wpt lat="49.3175" lon="-67.38"><name>Phare de Pointe-des-Monts</name><desc>[Day 2] (lighthouse) Erected 1830, one of the oldest circular stone lighthouses in North America; marks entrance to the Gulf of St. Lawrence with museum.</desc><type>lighthouse</type></wpt>
  <wpt lat="47.8045" lon="-69.887"><name>Port-au-Persil Waterfall &amp; Historic Chapel</name><desc>[Day 2] (hike) Hidden Charlevoix cove off Route 138 where a fresh mountain waterfall cascades directly over granite rocks into the saltwater St. Lawrence estuary.</desc><type>hike</type></wpt>
  <wpt lat="46.235" lon="-73.175"><name>Berthierville Esso</name><desc>[Day 2] (fuel) Route 138 Chemin du Roy backup station with 91 Premium.</desc><type>fuel</type></wpt>
  <wpt lat="46.345" lon="-72.547"><name>Trois-Rivières Shell</name><desc>[Day 2] (fuel) Chemin du Roy (Route 138) mid-stage top-off.</desc><type>fuel</type></wpt>
  <wpt lat="47.442" lon="-70.505"><name>Baie-Saint-Paul Shell</name><desc>[Day 2] (fuel) Route 138 Charlevoix gateway backup station with 91 Premium.</desc><type>fuel</type></wpt>
  <wpt lat="48.351" lon="-69.405"><name>Les Escoumins Shell</name><desc>[Day 2] (fuel) Route 138 North Shore backup station with 91 Premium.</desc><type>fuel</type></wpt>
  <wpt lat="49.2185" lon="-68.1485"><name>Baie-Comeau Shell V-Power Hub</name><desc>[Day 2] (fuel) CRITICAL: Mandatory top-off for both bikes and auxiliary fuel bladder before entering remote QC-389. Shell V-Power 91 available.</desc><type>fuel</type></wpt>
  <wpt lat="47.025" lon="-70.925"><name>Sainte-Anne-de-Beaupré Irving</name><desc>[Day 2] (fuel) Route 138 Côte-de-Beaupré strategic backup station before Charlevoix mountains.</desc><type>fuel</type></wpt>
  <wpt lat="48.15" lon="-69.72"><name>Tadoussac Pétro-T</name><desc>[Day 2] (fuel) Strategic backup station directly at the mouth of the Saguenay Fjord / ferry landing.</desc><type>fuel</type></wpt>
  <wpt lat="48.74" lon="-69.08"><name>Forestville Crevier</name><desc>[Day 2] (fuel) Route 138 North Shore strategic backup station between Les Escoumins and Baie-Comeau.</desc><type>fuel</type></wpt>
  <wpt lat="48.145" lon="-69.715"><name>Tadoussac Fjord Ferry (Route 138)</name><desc>[Day 2] (ferry) Free 10-minute year-round ferry crossing across the mouth of the Saguenay Fjord. Motorcyclists directed to front of queue.</desc><type>ferry</type></wpt>
  <wpt lat="46.805" lon="-71.21"><name>Boulevard Champlain &amp; Cap Diamant River Parkway</name><desc>[Day 2] (sight) Stunning river-level motorcycle boulevard curving beneath the towering cliffs of Quebec City and Château Frontenac.</desc><type>sight</type></wpt>
  <wpt lat="46.9" lon="-70.9"><name>Autoroute 50 &amp; Route 138 North Shore Scenic Corridor</name><desc>[Day 2] (sight) Historic Chemin du Roy and Côte-de-Beaupré bypassing Montreal and Hwy 40 entirely.</desc><type>sight</type></wpt>
  <wpt lat="46.3432" lon="-72.5421"><name>Microbrasserie Le Temps d'une Pinte (Trois-Rivières)</name><desc>[Day 2] (food) Award-winning Trois-Rivières craft microbrewery and kitchen bistrot serving artisanal Quebec cuisine and house-roasted coffee.</desc><type>food</type></wpt>
  <wpt lat="49.2165" lon="-68.1481"><name>St-Pancrace — Microbrasserie / Le Pub (Baie-Comeau)</name><desc>[Day 2] (food) 55 Pl. la Salle, Baie-Comeau. Celebrated Côte-Nord craft brewpub featuring boreal-inspired ales and hearty pub fare before launching up QC-389.</desc><type>food</type></wpt>
  <wpt lat="49.2219" lon="-68.1456"><name>Pêcherie Manicouagan Inc (Baie-Comeau)</name><desc>[Day 2] (food) 334 Bd la Salle, Baie-Comeau. Fresh St. Lawrence snow crab, Nordic shrimp, smoked salmon, and coastal seafood market.</desc><type>food</type></wpt>
  <wpt lat="46.3512" lon="-72.5785"><name>Starbucks (Trois-Rivières — Hwy 40)</name><desc>[Day 2] (coffee) 4520 Bd des Forges, Trois-Rivières, QC. Quick espresso stop off Autoroute 40.</desc><type>coffee</type></wpt>
  <wpt lat="47.0385" lon="-70.8962"><name>Tim Hortons (Beaupré / Sainte-Anne-de-Beaupré — Route 138)</name><desc>[Day 2] (coffee) 10620 Bd Sainte-Anne, Beaupré, QC. Right on Route 138 before climbing into the Charlevoix highlands.</desc><type>coffee</type></wpt>
  <wpt lat="47.6542" lon="-70.1518"><name>Tim Hortons (La Malbaie — Route 138)</name><desc>[Day 2] (coffee) 375 Bd de Comporté, La Malbaie, QC. Coffee &amp; warm-up stop along the St. Lawrence north shore.</desc><type>coffee</type></wpt>
  <wpt lat="52.91" lon="-66.86"><name>Hotel Wabush</name><desc>[Day 3] (hotel-primary) Safe, warm, rider-friendly hotel in Labrador West. On-site restaurant, high-speed WiFi, bear-safe protection.</desc><type>hotel-primary</type></wpt>
  <wpt lat="52.9536" lon="-66.9114"><name>Two Seasons Inn (Labrador City)</name><desc>[Day 3] (hotel-secondary) Full service hotel in Labrador City with dining and heated facilities.</desc><type>hotel-secondary</type></wpt>
  <wpt lat="50.6406" lon="-68.7247"><name>Manic-5 (Daniel-Johnson Dam)</name><desc>[Day 3] (attraction) World's largest multiple-arch hollow buttress dam. 214 m high, 1.3 km wide. Marvel of modern engineering.</desc><type>attraction</type></wpt>
  <wpt lat="51.9167" lon="-68.1667"><name>Gagnon Ghost Town (Abandoned Boreal Streets)</name><desc>[Day 3] (attraction) Km 485 on QC-389. Thriving 1970s mining city demolished in 1985. Concrete sidewalks and street curbs still intact in the forest.</desc><type>attraction</type></wpt>
  <wpt lat="52.7917" lon="-67.0833"><name>Fermont Windbreak Wall ('Le Mur')</name><desc>[Day 3] (attraction) Famous 1.3 km long, 5-story windbreak building sheltering the subarctic mining community from freezing arctic gales.</desc><type>attraction</type></wpt>
  <wpt lat="50.6402" lon="-68.7231"><name>Manic-5 Fuel (Motel de l'Énergie)</name><desc>[Day 3] (fuel) Km 214 on QC-389. Essential fuel stop next to Daniel-Johnson Dam. 87 Octane ONLY. Use bladder siphon or Lucas booster for Ducati.</desc><type>fuel</type></wpt>
  <wpt lat="51.326" lon="-68.1221"><name>Relais Gabriel Fuel Outpost</name><desc>[Day 3] (fuel) Km 316 on QC-389. Mandatory fuel top-up on eastern Manicouagan crater rim. 87 Octane ONLY. Use bladder siphon or Lucas booster for Ducati.</desc><type>fuel</type></wpt>
  <wpt lat="52.7917" lon="-67.0833"><name>Fermont Shell</name><desc>[Day 3] (fuel) Km 565 on QC-389. Full service Shell in Fermont mining town.</desc><type>fuel</type></wpt>
  <wpt lat="52.9464" lon="-66.9114"><name>Labrador City Ultramar Hub</name><desc>[Day 3] (fuel) Full city fuel station, Tim Hortons, hardware store.</desc><type>fuel</type></wpt>
  <wpt lat="51.329536" lon="-68.133731"><name>Zone Camping Relais de Gabriel</name><desc>[Day 3] (hotel-secondary) Wilderness camping backup zone at Relais Gabriel (km 318 of Route 389) right after the Manic-5 to Relais Gabriel gravel stretch.</desc><type>hotel-secondary</type></wpt>
  <wpt lat="51.471759" lon="-68.236055"><name>Station Uapishka — Monts Groulx (Hotel Backup)</name><desc>[Day 3] (hotel-secondary) UNESCO Manicouagan-Uapishka Biosphere Reserve eco-lodge, inn, and outfitter backup at the base of the Monts Groulx (km 336 of QC-389).</desc><type>hotel-secondary</type></wpt>
  <wpt lat="52.774307" lon="-67.324279"><name>Campement Modulaire (Mont-Wright / QC-389)</name><desc>[Day 3] (hotel-secondary) Modular camp facility near Mont-Wright and the southern approach to Fermont on Route 389.</desc><type>hotel-secondary</type></wpt>
  <wpt lat="52.811832" lon="-67.219923"><name>Pourvoirie Lac Justone Fermont | Rivière Caniapiscau</name><desc>[Day 3] (hotel-secondary) Outfitter cabin and wilderness camping backup on Lac Justone just west of Fermont on Route 389.</desc><type>hotel-secondary</type></wpt>
  <wpt lat="52.896068" lon="-66.997964"><name>Duley Lake Provincial Park Campground</name><desc>[Day 3] (hotel-secondary) Scenic lakeside provincial park campground between the Québec/Labrador border and Labrador City / Wabush.</desc><type>hotel-secondary</type></wpt>
  <wpt lat="52.937108" lon="-66.919275"><name>Trish’s Place (Wabush / Labrador City B&amp;B Backup)</name><desc>[Day 3] (hotel-secondary) Welcoming local guesthouse and B&amp;B lodging backup in Wabush / Labrador City.</desc><type>hotel-secondary</type></wpt>
  <wpt lat="52.95046" lon="-66.919026"><name>Gateway Labrador — Visitor Information Centre w/ Campsites</name><desc>[Day 3] (hotel-secondary) Labrador West visitor centre, museum, and RV/tent camping backup right on Route 500 in Labrador City.</desc><type>hotel-secondary</type></wpt>
  <wpt lat="51.608152" lon="-68.230754"><name>Stationnement Harfang-Nord (Monts Groulx Trailhead Parking)</name><desc>[Day 3] (pullout) Official Monts Groulx Harfang-Nord trailhead parking &amp; emergency highway stopping area on QC-389.</desc><type>pullout</type></wpt>
  <wpt lat="51.682533" lon="-68.111869"><name>Stationnement Départ Monts Groulx Nord/Sud</name><desc>[Day 3] (pullout) Official Monts Groulx North/South trailhead parking lot &amp; safe roadside pullout on QC-389.</desc><type>pullout</type></wpt>
  <wpt lat="52.553079" lon="-67.428593"><name>Large Area for Parking Stop (QC-389 Pullout)</name><desc>[Day 3] (pullout) Extra-large graded gravel roadside staging &amp; emergency parking area along Route 389.</desc><type>pullout</type></wpt>
