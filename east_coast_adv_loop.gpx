  </wpt>
  <wpt lat="48.337000" lon="-69.467000">
    <name>Phare de Cap-de-Bon-Désir</name>
    <desc>Historic navigational station on granite ledges dropping 300 meters into the St. Lawrence Laurentian Channel; prime shore whale watching.</desc>
    <sym>Light</sym>
  </wpt>
  <wpt lat="49.317500" lon="-67.380000">
    <name>Phare de Pointe-des-Monts</name>
    <desc>Erected 1830, one of the oldest circular stone lighthouses in North America; marks entrance to the Gulf of St. Lawrence with museum.</desc>
    <sym>Light</sym>
  </wpt>
  <wpt lat="51.457200" lon="-56.864700">
    <name>Point Amour Lighthouse</name>
    <desc>Tallest lighthouse in Atlantic Canada (109 ft / 33 m) and 2nd tallest in Canada; completed in 1857 guarding the treacherous Strait of Belle Isle.</desc>
    <sym>Light</sym>
  </wpt>
  <wpt lat="51.631500" lon="-55.903000">
    <name>Cape Norman Lighthouse</name>
    <desc>Towering cliffside light marking the absolute northernmost tip of the island of Newfoundland; sweeps Strait of Belle Isle iceberg alley.</desc>
    <sym>Light</sym>
  </wpt>
  <wpt lat="51.360800" lon="-55.553900">
    <name>Fishing Point Lighthouse (Fox Point Light - St. Anthony)</name>
    <desc>Famous red-and-white beacon perched atop jagged coastal cliffs at Fishing Point in St. Anthony. Prime iceberg watching and marine trails.</desc>
    <sym>Light</sym>
  </wpt>
  <wpt lat="51.608800" lon="-55.623200">
    <name>Cape Onion / Quirpon Island Lookout</name>
    <desc>Rugged clifftop headland looking out across the Atlantic toward Quirpon Island Light (1860) and iceberg drift channels.</desc>
    <sym>Light</sym>
  </wpt>
  <wpt lat="50.703000" lon="-57.411000">
    <name>Pointe Riche Lighthouse &amp; Limestone Barrens</name>
    <desc>Historic 1892 octagonal wooden pepperpot lighthouse on dramatic fossil-rich limestone sea barrens in Port au Choix.</desc>
    <sym>Light</sym>
  </wpt>
  <wpt lat="49.605500" lon="-57.958000">
    <name>Lobster Cove Head Lighthouse</name>
    <desc>Historic 1897 wooden light marking the entrance to Bonne Bay in Gros Morne National Park; panoramic sunset vistas and coastal trails.</desc>
    <sym>Light</sym>
  </wpt>
  <wpt lat="49.502800" lon="-57.918900">
    <name>Woody Point Lighthouse</name>
    <desc>Iconic 1919 square pyramid wooden pepperpot tower guarding the south entrance to Bonne Bay and the Tablelands fjord in Gros Morne NP.</desc>
    <sym>Light</sym>
  </wpt>
  <wpt lat="47.900000" lon="-59.408000">
    <name>Cape Anguille Lighthouse</name>
    <desc>Historic 1905 light marking the absolute westernmost point of the island of Newfoundland; dramatic Gulf of St. Lawrence ocean cliffs.</desc>
    <sym>Light</sym>
  </wpt>
  <wpt lat="47.618000" lon="-59.293000">
    <name>Cape Ray Lighthouse</name>
    <desc>Established 1871; historic landfall for the first transatlantic telegraph cable from Ireland; sweeps Cabot Strait and maritime trade route.</desc>
    <sym>Light</sym>
  </wpt>
  <wpt lat="46.812000" lon="-60.320000">
    <name>Neil's Harbour Lighthouse &amp; Chowder House</name>
    <desc>1899 coastal wooden lighthouse serving fresh ice cream and Atlantic seafood chowder perched over crashing Cabot Trail surf.</desc>
    <sym>Light</sym>
  </wpt>
  <wpt lat="46.903000" lon="-60.460000">
    <name>St. Paul Island Southwest Lighthouse (Dingwall)</name>
    <desc>Rare 1915 cylindrical cast iron lighthouse relocated from the treacherous 'Graveyard of the Gulf' (St. Paul Island) to Dingwall Harbour.</desc>
    <sym>Light</sym>
  </wpt>
  <wpt lat="46.663000" lon="-61.025000">
    <name>Chéticamp Enragée Point Lighthouse</name>
    <desc>Historic coastal beacon on Chéticamp Island overlooking the Gulf of St. Lawrence and Acadian fishing fleet.</desc>
    <sym>Light</sym>
  </wpt>
  <wpt lat="46.435000" lon="-61.108000">
    <name>Margaree Harbour Range Lights</name>
    <desc>Twin 1900 Acadian wooden range lights guiding fishing schooners into the mouth of the Margaree River salmon estuary.</desc>
    <sym>Light</sym>
  </wpt>
  <wpt lat="46.215000" lon="-63.488000">
    <name>Victoria Harbour Range Lighthouse</name>
    <desc>1879 wooden square tapered tower in the historic artisan fishing and seafaring village of Victoria-by-the-Sea on PEI's south shore.</desc>
    <sym>Light</sym>
  </wpt>
  <wpt lat="46.524000" lon="-63.504000">
    <name>Cape Tryon Lighthouse</name>
    <desc>Iconic lighthouse perched on 110-foot vertical red sandstone cliffs overlooking Gulf of St. Lawrence; inspiration for L.M. Montgomery's Four Winds Light.</desc>
    <sym>Light</sym>
  </wpt>
  <wpt lat="46.460000" lon="-63.292000">
    <name>North Rustico Harbour Lighthouse</name>
    <desc>1876 square pyramid pepperpot lighthouse with attached keeper's dwelling in a classic active PEI lobster fishing harbour.</desc>
    <sym>Light</sym>
  </wpt>
  <wpt lat="46.431000" lon="-63.146000">
    <name>Covehead Harbour Lighthouse</name>
    <desc>Beloved 1975 pepperpot lighthouse nestled among the rolling coastal sand dunes of Prince Edward Island National Park.</desc>
    <sym>Light</sym>
  </wpt>
  <wpt lat="46.058000" lon="-63.048000">
    <name>Point Prim Lighthouse</name>
    <desc>Built 1845, the oldest lighthouse on Prince Edward Island and one of only a few round brick lighthouses in Canada.</desc>
    <sym>Light</sym>
  </wpt>
  <wpt lat="46.619000" lon="-64.387000">
    <name>West Point Lighthouse</name>
    <desc>PEI's tallest lighthouse (69 ft), famous for its striking black-and-white horizontal stripes and Northumberland Strait sunsets.</desc>
    <sym>Light</sym>
  </wpt>
  <wpt lat="46.319000" lon="-63.610000">
    <name>Seacow Head Lighthouse</name>
    <desc>Built 1863; one of PEI's oldest octagonal wooden lights; famous feature in 'Road to Avonlea' perched above red sandstone sea arches.</desc>
    <sym>Light</sym>
  </wpt>
  <wpt lat="46.132000" lon="-63.778000">
    <name>Cape Tormentine Lighthouse</name>
    <desc>Historic light marking the former ice-boat and rail-ferry terminal crossing the Northumberland Strait to PEI.</desc>
    <sym>Light</sym>
  </wpt>
  <wpt lat="46.155000" lon="-63.812000">
    <name>Cape Jourimain Lighthouse</name>
    <desc>1870 octagonal wood lighthouse standing watch beside the massive spans of Confederation Bridge in Cape Jourimain Nature Centre.</desc>
    <sym>Light</sym>
  </wpt>
  <wpt lat="45.594000" lon="-64.783000">
    <name>Cape Enrage Lighthouse &amp; Cliffs</name>
    <desc>Built 1838 atop 150-foot jagged cliffs thrust into the Bay of Fundy; faces the most powerful 50-foot tidal rips in the world.</desc>
    <sym>Light</sym>
  </wpt>
  <wpt lat="45.735200" lon="-64.697300">
    <name>Anderson Hollow Lighthouse</name>
    <desc>Historic 1903 wooden salt-shaker pepperpot lighthouse; originally built on Salisbury Bay breakwater at Waterside, now preserved and restored at Harvey Bank Heritage Shipyard Park off Route 915.</desc>
    <sym>Light</sym>
  </wpt>
  <wpt lat="45.323000" lon="-65.538000">
    <name>Quaco Head Lighthouse</name>
    <desc>Perched on towering headland near St. Martins sea caves along the Fundy Trail Parkway; sweeping vistas of the Bay of Fundy.</desc>
    <sym>Light</sym>
  </wpt>
  <wpt lat="46.491700" lon="-63.385000">
    <name>Anne of Green Gables Heritage Place</name>
    <desc>Historic 19th-century Victorian farmstead, Haunted Wood trail, and Lovers Lane that inspired L.M. Montgomery's classic novel.</desc>
    <sym>Scenic Area</sym>
  </wpt>
  <wpt lat="46.505000" lon="-63.468000">
    <name>L.M. Montgomery's Birthplace (New London)</name>
    <desc>Cozy white-and-green farmhouse in New London where author Lucy Maud Montgomery was born in 1874. Displays replica wedding dress and scrapbooks.</desc>
    <sym>Scenic Area</sym>
  </wpt>
  <wpt lat="46.521000" lon="-63.535000">
    <name>Anne of Green Gables Museum at Silver Bush</name>
    <desc>Historic Campbell family homestead where Montgomery was married. Features Matthew's carriage rides and views over the Lake of Shining Waters.</desc>
    <sym>Scenic Area</sym>
  </wpt>
  <wpt lat="46.525000" lon="-63.538000">
    <name>Lake of Shining Waters (Park Corner)</name>
    <desc>Pristine freshwater pond glistening behind the coastal barrier dunes immortalized by Montgomery as 'The Lake of Shining Waters'.</desc>
    <sym>Scenic Area</sym>
  </wpt>
  <wpt lat="46.516000" lon="-63.513000">
    <name>French River Overlook &amp; Fishing Cove</name>
    <desc>Postcard-perfect PEI landscape of rolling emerald green potato fields sloping down to colorful fishing shacks on the quiet river inlet.</desc>
    <sym>Scenic Area</sym>
  </wpt>
  <wpt lat="46.498000" lon="-63.415000">
    <name>Cavendish Beach Sandstone Sea Stacks</name>
    <desc>Towering red sandstone arches, caves, and barrier dunes glowing fiery red in the late afternoon sun along the Cavendish coastline.</desc>
    <sym>Scenic Area</sym>
  </wpt>
  <wpt lat="46.486000" lon="-63.382000">
    <name>Site of L.M. Montgomery's Cavendish Home</name>
    <desc>Peaceful wooded homestead where Montgomery was raised by her grandparents and wrote Anne of Green Gables. Path through apple orchard.</desc>
    <sym>Scenic Area</sym>
  </wpt>
  <wpt lat="47.804500" lon="-69.887000">
    <name>Port-au-Persil Waterfall &amp; Historic Chapel</name>
    <desc>Hidden Charlevoix cove off Route 138 where a fresh mountain waterfall cascades directly over granite rocks into the saltwater St. Lawrence estuary.</desc>
    <sym>Scenic Area</sym>
  </wpt>
  <wpt lat="51.733000" lon="-56.425000">
    <name>Tracey Hill 700-Step Overlook (Red Bay)</name>
    <desc>700 wooden boardwalk stairs climbing Tracey Hill behind the Red Bay UNESCO Basque Whaling Station. Panoramic view over Saddle Island icebergs.</desc>
    <sym>Scenic Area</sym>
  </wpt>
  <wpt lat="51.605000" lon="-55.760000">
    <name>Burnt Cape Ecological Reserve (Arctic Barrens)</name>
    <desc>Alien subarctic landscape near Raleigh resembling the surface of Mars. Coastal limestone sea arches, wave-carved caves, and rare arctic plants.</desc>
    <sym>Scenic Area</sym>
  </wpt>
  <wpt lat="49.682000" lon="-57.962000">
    <name>Green Point Geological Golden Spike (GSSP)</name>
    <desc>UN Global Boundary Stratotype Section and Point (GSSP). Layered coastal shale cliffs marking 500-million-year-old geological boundary with graptolite fossils.</desc>
    <sym>Scenic Area</sym>
  </wpt>
  <wpt lat="49.493000" lon="-58.125000">
    <name>Trout River Eastern Point Clifftop Trail</name>
    <desc>Spectacular 30-minute wooden stairway trail rising to open grassy cliff headlands where sheep graze above crashing Gulf swells.</desc>
    <sym>Scenic Area</sym>
  </wpt>
  <wpt lat="46.903000" lon="-60.355000">
    <name>White Point Unknown Sailor Clifftop Trail</name>
    <desc>Rugged coastal path out onto an isolated rocky headland jutting into the Atlantic. Sea bird colonies and the solitary white cross of the Unknown Sailor's grave.</desc>
    <sym>Scenic Area</sym>
  </wpt>
  <wpt lat="46.777000" lon="-60.331000">
    <name>Black Brook Cove Waterfall &amp; Ocean Beach</name>
    <desc>Spectacular Atlantic ocean beach in Cape Breton Highlands where a freshwater mountain brook and waterfall cascade over sea cliffs onto the sand.</desc>
    <sym>Scenic Area</sym>
  </wpt>
  <wpt lat="46.745000" lon="-60.875000">
    <name>Skyline Trail Boardwalk Hike</name>
    <desc>World-famous 2-hour coastal hike to a dramatic wooden boardwalk looking down on the Cabot Trail hairpins, crashing ocean, and grazing moose.</desc>
    <sym>Scenic Area</sym>
  </wpt>
  <wpt lat="45.589000" lon="-64.962000">
    <name>Dickson Falls Lush Mossy Gorge Boardwalk</name>
    <desc>Fundy National Park's most popular short hike: a 1.5 km wooden boardwalk descending into a cool, lush microclimate ravine blanketed in moss and ferns.</desc>
    <sym>Scenic Area</sym>
  </wpt>
  <wpt lat="46.262000" lon="-78.915000">
    <name>Eau Claire Gorges Conservation Area</name>
    <desc>Dramatic 2.5 km Canadian Shield trail through an ancient granite river gorge near Mattawa with a 40-foot waterfall and 1870s logger cabin ruins.</desc>
    <sym>Scenic Area</sym>
  </wpt>
  <wpt lat="50.640600" lon="-68.724700">
    <name>Manic-5 (Daniel-Johnson Dam)</name>
    <desc>World's largest multiple-arch hollow buttress dam. 214 m high, 1.3 km wide. Marvel of modern engineering.</desc>
    <sym>Scenic Area</sym>
  </wpt>
  <wpt lat="51.916700" lon="-68.166700">
    <name>Gagnon Ghost Town (Abandoned Boreal Streets)</name>
    <desc>Km 485 on QC-389. Thriving 1970s mining city demolished in 1985. Concrete sidewalks and street curbs still intact in the forest.</desc>
    <sym>Scenic Area</sym>
  </wpt>
  <wpt lat="52.791700" lon="-67.083300">
    <name>Fermont Windbreak Wall ('Le Mur')</name>
    <desc>Famous 1.3 km long, 5-story windbreak building sheltering the subarctic mining community from freezing arctic gales.</desc>
    <sym>Scenic Area</sym>
  </wpt>
  <wpt lat="53.533300" lon="-64.000000">
    <name>Churchill Falls Underground Hydro Plant</name>
    <desc>5,428 MW underground power station hollowed out of solid Precambrian granite 1,000 feet beneath the surface.</desc>
    <sym>Scenic Area</sym>
  </wpt>
  <wpt lat="51.465000" lon="-56.865000">
    <name>L'Anse Amour 7,500-Year Burial Mound</name>
    <desc>The oldest known human-constructed funeral burial mound in North America (Maritime Archaic Indigenous culture, 5500 BCE), marked by a stone cairn.</desc>
    <sym>Scenic Area</sym>
  </wpt>
  <wpt lat="51.455000" lon="-56.868000">
    <name>HMS Raleigh 1922 Shipwreck &amp; Raleigh Trail</name>
    <desc>Remains of the 600-ft British Royal Navy heavy cruiser HMS Raleigh that ran aground in blinding fog in 1922 beneath Point Amour. Steam boilers visible on beach.</desc>
    <sym>Scenic Area</sym>
  </wpt>
  <wpt lat="51.733300" lon="-56.416700">
    <name>Red Bay Basque Whaling Station (UNESCO)</name>
    <desc>UNESCO World Heritage Site. 16th-century Basque whaling headquarters in North America. Sunken galleons &amp; tryworks rendering ovens.</desc>
    <sym>Scenic Area</sym>
  </wpt>
  <wpt lat="51.595600" lon="-55.531400">
    <name>L'Anse aux Meadows (UNESCO Viking Settlement)</name>
    <desc>Only confirmed Norse Viking site in North America (circa 1000 AD). Authentic turf houses, blacksmith shop, and archaeological museum.</desc>
    <sym>Scenic Area</sym>
  </wpt>
  <wpt lat="51.599000" lon="-55.520000">
    <name>Norstead Viking Village &amp; Snorri Knarr Ship</name>
    <desc>Living history Viking trading port featuring the 54-foot replica knarr merchant ship 'Snorri', axe throwing, and forge.</desc>
    <sym>Scenic Area</sym>
  </wpt>
  <wpt lat="51.363000" lon="-55.599000">
    <name>Grenfell Historic Properties &amp; Museum (St. Anthony)</name>
    <desc>Historic mission headquarters of Dr. Wilfred Grenfell who brought modern medicine to remote Newfoundland and Labrador. Historic home and museum.</desc>
    <sym>Scenic Area</sym>
  </wpt>
  <wpt lat="49.831000" lon="-57.872000">
    <name>Broom Point Traditional Cod Fishing Premises</name>
    <desc>Preserved 1960s inshore cod-fishing family cabin and workshop in Gros Morne. Restored wooden dories, drying flakes, and living history.</desc>
    <sym>Scenic Area</sym>
  </wpt>
  <wpt lat="47.715000" lon="-59.325000">
    <name>Wreckhouse Extreme Winds Corridor</name>
    <desc>Legendary coastal funnel where southeastern mountain gusts exceed 200 km/h, famously blowing trains off their tracks.</desc>
    <sym>Scenic Area</sym>
  </wpt>
  <wpt lat="46.273000" lon="-60.598500">
    <name>The Gaelic College / Colaisde na Gàidhlig (St. Ann's)</name>
    <desc>Historic Gaelic cultural learning institution founded in 1938 at the start of the Cabot Trail in St. Ann's; preserves Highland Scottish heritage and Celtic arts.</desc>
    <sym>Scenic Area</sym>
  </wpt>
  <wpt lat="45.273300" lon="-66.063300">
    <name>Saint John City Market (1876)</name>
    <desc>Canada's oldest continuously operating farmer's market, featuring a unique timber roof hand-crafted by 19th-century shipbuilders shaped like an inverted ship's hull.</desc>
    <sym>Scenic Area</sym>
  </wpt>
  <wpt lat="46.297000" lon="-67.528000">
    <name>Hartland World's Longest Covered Bridge (1901)</name>
    <desc>The longest covered wooden bridge in the world (1,282 ft / 391 m), built in 1901 across the Saint John River. You can ride your bikes right through!</desc>
    <sym>Scenic Area</sym>
  </wpt>
  <wpt lat="45.568000" lon="-74.376000">
    <name>Carillon Canal National Historic Lock</name>
    <desc>Historic 19th-century military canal on the Ottawa River built after the War of 1812 with a massive 20-metre single hydraulic guillotine lock.</desc>
    <sym>Scenic Area</sym>
  </wpt>
