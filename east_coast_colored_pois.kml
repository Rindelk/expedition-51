    <Folder>
      <name>Points of Interest</name>
      <Placemark>
        <name>Hanmer Home Base (Start)</name>
        <description>Expedition departure point (4671 Dupuis Drive, Hanmer, ON). Full 87 &amp; 91 fuel tanks.</description>
        <Point>
          <coordinates>-80.882479,46.656232,0</coordinates>
        </Point>
      </Placemark>
      <Placemark>
        <name>Motel au P'tit Sapin (Mirabel)</name>
        <description>Ground-level roadside motel on Route 117 in Mirabel. Room-front exterior motorcycle parking right outside your door.</description>
        <Point>
          <coordinates>-73.966347,45.734760,0</coordinates>
        </Point>
      </Placemark>
      <Placemark>
        <name>Travelodge by Wyndham Baie-Comeau</name>
        <description>Clean, highly-rated rider-friendly motor inn directly on Route 138. Easy ground-floor motorcycle parking.</description>
        <Point>
          <coordinates>-68.155000,49.215000,0</coordinates>
        </Point>
      </Placemark>
      <Placemark>
        <name>Hotel Wabush</name>
        <description>Safe, warm, rider-friendly hotel in Labrador West. On-site restaurant, high-speed WiFi, bear-safe protection.</description>
        <Point>
          <coordinates>-66.860000,52.910000,0</coordinates>
        </Point>
      </Placemark>
      <Placemark>
        <name>Royal Inn &amp; Suites (Goose Bay)</name>
        <description>Quiet, comfortable suites with kitchenettes in Happy Valley-Goose Bay. Secure parking, hot showers.</description>
        <Point>
          <coordinates>-60.325000,53.305000,0</coordinates>
        </Point>
      </Placemark>
      <Placemark>
        <name>Northern Light Inn (L'Anse-au-Clair)</name>
        <description>Rider-favorite coastal hotel 5 km from Blanc-Sablon ferry terminal. Warm rooms, seafood dining, early ferry staging.</description>
        <Point>
          <coordinates>-57.060000,51.420000,0</coordinates>
        </Point>
      </Placemark>
      <Placemark>
        <name>Snorri Cabins / Valhalla Lodge (Hay Cove)</name>
        <description>Authentic turf-roofed and wooden rustic Viking cabins 2 km from L'Anse aux Meadows. Full kitchen, private deck, ocean vistas.</description>
        <Point>
          <coordinates>-55.533300,51.583300,0</coordinates>
        </Point>
      </Placemark>
      <Placemark>
        <name>Snorri Cabins / Valhalla Lodge (Hay Cove) - Night 2</name>
        <description>Night 2 in the Viking cabins. Relax around the woodstove after exploring Norstead and St. Anthony.</description>
        <Point>
          <coordinates>-55.533300,51.583300,0</coordinates>
        </Point>
      </Placemark>
      <Placemark>
        <name>Gros Morne / Norris Point KOA Holiday</name>
        <description>Full-service KOA at Route 430 junction in Gros Morne. Commercial laundromat to reset riding gear, heated pool, hot showers, bike wash.</description>
        <Point>
          <coordinates>-57.880000,49.560000,0</coordinates>
        </Point>
      </Placemark>
      <Placemark>
        <name>Green Point Campground (Gros Morne NP)</name>
        <description>World-class coastal drive-in campground in Gros Morne perched on seaside bluffs overlooking the Gulf of St. Lawrence. Ocean sunset, campfire surf.</description>
        <Point>
          <coordinates>-57.850000,49.683300,0</coordinates>
        </Point>
      </Placemark>
      <Placemark>
        <name>Marine Atlantic Overnight Ferry (Private 2-Berth Stateroom Cabin)</name>
        <description>Private 2-berth en-suite stateroom aboard MV Highlanders / MV Blue Puttees. Boarding 21:45, sailing 23:45 across Cabot Strait to North Sydney arriving 07:00 AM.</description>
        <Point>
          <coordinates>-59.136000,47.575000,0</coordinates>
        </Point>
      </Placemark>
      <Placemark>
        <name>Broad Cove Campground (Cape Breton Highlands NP)</name>
        <description>Spectacular oceanfront National Park campground in Ingonish directly on the Cabot Trail. Sandy ocean beach, hot showers, flush toilets, campfire pits.</description>
        <Point>
          <coordinates>-60.400000,46.680000,0</coordinates>
        </Point>
      </Placemark>
      <Placemark>
        <name>Chéticamp Campground (Cape Breton Highlands NP)</name>
        <description>Tucked in the mountain valley at the western park entrance of the Cabot Trail. Hot showers, walking distance to Chéticamp village.</description>
        <Point>
          <coordinates>-60.980000,46.640000,0</coordinates>
        </Point>
      </Placemark>
      <Placemark>
        <name>Cavendish Campground (Prince Edward Island National Park)</name>
        <description>Pristine Parks Canada oceanfront campground directly on the Gulf of St. Lawrence red sand dunes and sandstone cliffs. Walking access to Cavendish Beach and 3 min to Anne of Green Gables.</description>
        <Point>
          <coordinates>-63.402000,46.495000,0</coordinates>
        </Point>
      </Placemark>
      <Placemark>
        <name>Fundy National Park (Headquarters Campground)</name>
        <description>Perched on seaside bluffs overlooking the Bay of Fundy above Alma harbor. Heated washrooms, hot showers, walk down to fresh Fundy lobster.</description>
        <Point>
          <coordinates>-64.952000,45.598000,0</coordinates>
        </Point>
      </Placemark>
      <Placemark>
        <name>de la République Provincial Park (Edmundston)</name>
        <description>Pristine provincial park 1.5 km off TCH-2 on the Madawaska River. Heated pool, hot showers, flush toilets, shaded wooded sites.</description>
        <Point>
          <coordinates>-68.390000,47.435000,0</coordinates>
        </Point>
      </Placemark>
      <Placemark>
        <name>Camping des Voltigeurs (Sépaq - Drummondville)</name>
        <description>Tranquil riverside Sépaq park along the Saint-François River off A-20. Clean hot showers, quiet wooded campsites, zero city congestion.</description>
        <Point>
          <coordinates>-72.469400,45.883300,0</coordinates>
        </Point>
      </Placemark>
      <Placemark>
        <name>Best Western Pembroke Inn &amp; Conference Centre</name>
        <description>Full-service motor hotel off Hwy 17 with large indoor heated pool, hot tub, fitness center, on-site restaurant, and ground-level rooms.</description>
        <Point>
          <coordinates>-77.098000,45.793200,0</coordinates>
        </Point>
      </Placemark>
      <Placemark>
        <name>Hanmer Home Base (Arrival)</name>
        <description>Celebratory homecoming at 4671 Dupuis Drive, Hanmer, ON! Saturday afternoon completion.</description>
        <Point>
          <coordinates>-80.882479,46.656232,0</coordinates>
        </Point>
      </Placemark>
