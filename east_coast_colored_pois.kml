        <Point>
          <coordinates>-68.390000,47.435000,0</coordinates>
        </Point>
      </Placemark>
      <Placemark>
        <name>Camping des Voltigeurs (Sépaq Park)</name>
        <description>Sépaq riverside conservation park along the Saint-François River.</description>
        <Point>
          <coordinates>-72.469400,45.883300,0</coordinates>
        </Point>
      </Placemark>
      <Placemark>
        <name>Driftwood Provincial Park (Ottawa River)</name>
        <description>Quiet Ontario provincial park on Laurentian river shoreline.</description>
        <Point>
          <coordinates>-77.685000,46.185000,0</coordinates>
        </Point>
      </Placemark>
      <Placemark>
        <name>Phare du Moulin-à-Baude (Tadoussac)</name>
        <description>Historic red-and-white coastal beacon perched above the St. Lawrence estuary and Saguenay Fjord confluence; world-class beluga whale lookout.</description>
        <Point>
          <coordinates>-69.697500,48.154200,0</coordinates>
        </Point>
      </Placemark>
      <Placemark>
        <name>Phare de Cap-de-Bon-Désir</name>
        <description>Historic navigational station on granite ledges dropping 300 meters into the St. Lawrence Laurentian Channel; prime shore whale watching.</description>
        <Point>
          <coordinates>-69.467000,48.337000,0</coordinates>
        </Point>
      </Placemark>
      <Placemark>
        <name>Phare de Pointe-des-Monts</name>
        <description>Erected 1830, one of the oldest circular stone lighthouses in North America; marks entrance to the Gulf of St. Lawrence with museum.</description>
        <Point>
          <coordinates>-67.380000,49.317500,0</coordinates>
        </Point>
      </Placemark>
      <Placemark>
        <name>Point Amour Lighthouse</name>
        <description>Tallest lighthouse in Atlantic Canada (109 ft / 33 m) and 2nd tallest in Canada; completed in 1857 guarding the treacherous Strait of Belle Isle.</description>
        <Point>
          <coordinates>-56.864700,51.457200,0</coordinates>
        </Point>
      </Placemark>
      <Placemark>
        <name>Cape Norman Lighthouse</name>
        <description>Towering cliffside light marking the absolute northernmost tip of the island of Newfoundland; sweeps Strait of Belle Isle iceberg alley.</description>
        <Point>
          <coordinates>-55.903000,51.631500,0</coordinates>
        </Point>
      </Placemark>
      <Placemark>
        <name>Fishing Point Lighthouse (Fox Point Light - St. Anthony)</name>
        <description>Famous red-and-white beacon perched atop jagged coastal cliffs at Fishing Point in St. Anthony. Prime iceberg watching and marine trails.</description>
        <Point>
          <coordinates>-55.553900,51.360800,0</coordinates>
        </Point>
      </Placemark>
      <Placemark>
        <name>Cape Onion / Quirpon Island Lookout</name>
        <description>Rugged clifftop headland looking out across the Atlantic toward Quirpon Island Light (1860) and iceberg drift channels.</description>
        <Point>
          <coordinates>-55.623200,51.608800,0</coordinates>
        </Point>
      </Placemark>
      <Placemark>
        <name>Pointe Riche Lighthouse &amp; Limestone Barrens</name>
        <description>Historic 1892 octagonal wooden pepperpot lighthouse on dramatic fossil-rich limestone sea barrens in Port au Choix.</description>
        <Point>
          <coordinates>-57.411000,50.703000,0</coordinates>
        </Point>
      </Placemark>
      <Placemark>
        <name>Lobster Cove Head Lighthouse</name>
        <description>Historic 1897 wooden light marking the entrance to Bonne Bay in Gros Morne National Park; panoramic sunset vistas and coastal trails.</description>
        <Point>
          <coordinates>-57.958000,49.605500,0</coordinates>
        </Point>
      </Placemark>
      <Placemark>
        <name>Woody Point Lighthouse</name>
        <description>Iconic 1919 square pyramid wooden pepperpot tower guarding the south entrance to Bonne Bay and the Tablelands fjord in Gros Morne NP.</description>
        <Point>
          <coordinates>-57.918900,49.502800,0</coordinates>
        </Point>
      </Placemark>
      <Placemark>
        <name>Cape Anguille Lighthouse</name>
        <description>Historic 1905 light marking the absolute westernmost point of the island of Newfoundland; dramatic Gulf of St. Lawrence ocean cliffs.</description>
        <Point>
          <coordinates>-59.408000,47.900000,0</coordinates>
        </Point>
      </Placemark>
      <Placemark>
        <name>Cape Ray Lighthouse</name>
        <description>Established 1871; historic landfall for the first transatlantic telegraph cable from Ireland; sweeps Cabot Strait and maritime trade route.</description>
        <Point>
          <coordinates>-59.293000,47.618000,0</coordinates>
        </Point>
      </Placemark>
      <Placemark>
        <name>Neil's Harbour Lighthouse &amp; Chowder House</name>
        <description>1899 coastal wooden lighthouse serving fresh ice cream and Atlantic seafood chowder perched over crashing Cabot Trail surf.</description>
        <Point>
          <coordinates>-60.320000,46.812000,0</coordinates>
        </Point>
      </Placemark>
      <Placemark>
        <name>St. Paul Island Southwest Lighthouse (Dingwall)</name>
        <description>Rare 1915 cylindrical cast iron lighthouse relocated from the treacherous 'Graveyard of the Gulf' (St. Paul Island) to Dingwall Harbour.</description>
        <Point>
          <coordinates>-60.460000,46.903000,0</coordinates>
        </Point>
      </Placemark>
      <Placemark>
        <name>Chéticamp Enragée Point Lighthouse</name>
        <description>Historic coastal beacon on Chéticamp Island overlooking the Gulf of St. Lawrence and Acadian fishing fleet.</description>
        <Point>
          <coordinates>-61.025000,46.663000,0</coordinates>
        </Point>
      </Placemark>
      <Placemark>
        <name>Margaree Harbour Range Lights</name>
        <description>Twin 1900 Acadian wooden range lights guiding fishing schooners into the mouth of the Margaree River salmon estuary.</description>
        <Point>
          <coordinates>-61.108000,46.435000,0</coordinates>
        </Point>
      </Placemark>
      <Placemark>
        <name>Victoria Harbour Range Lighthouse</name>
        <description>1879 wooden square tapered tower in the historic artisan fishing and seafaring village of Victoria-by-the-Sea on PEI's south shore.</description>
        <Point>
          <coordinates>-63.488000,46.215000,0</coordinates>
        </Point>
      </Placemark>
      <Placemark>
