        </Point>
      </Placemark>
      <Placemark>
        <name>Fundy National Park (Headquarters Bayview)</name>
        <description>Clifftop park campground above Alma harbor overlooking the highest tides on Earth.</description>
        <Point>
          <coordinates>-64.952000,45.598000,0</coordinates>
        </Point>
      </Placemark>
      <Placemark>
        <name>Parc provincial de la République (Madawaska River)</name>
